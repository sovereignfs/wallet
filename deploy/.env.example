# Copy to `.env` (next to the compose files) and edit. Keep it out of version control: it holds secrets.
# Every setting Wallet reads is described in the repository's own .env.example; these are the ones a deployment sets.

# --- The address people use ---------------------------------------------------------------------------------------
# https, except on localhost, with no path. Passkeys, emailed links and the Sovereign redirect address are made from it.
WALLET_URL=http://localhost:3006
# The port on this machine that a reverse proxy sends to (the container listens on 3006, the port in sovereign.manifest.json).
# WALLET_PORT=3006

# --- Signing in: at least one way must be on to use the app -------------------------------------------------------
WALLET_AUTH_LOCAL=1
# 32 characters or more:  openssl rand -base64 48
WALLET_AUTH_SECRET=
# `closed`: the first account only. `open`: anyone who can reach the page. Unset, it is `closed`, or `open` when a Sovereign core is the only way in.
WALLET_AUTH_SIGNUP=closed

# --- The server's own key -----------------------------------------------------------------------------------------
# Seals the server's own secrets at rest, and never what people keep in their wallets (that is sealed in their browsers). Make it once and keep it with
# your secrets, apart from the database backups.   openssl rand -base64 32
WALLET_ENCRYPTION_KEY=

# --- PostgreSQL (compose.postgres.yaml only) ----------------------------------------------------------------------
# The database's own password.   openssl rand -hex 16
POSTGRES_PASSWORD=
