{
  "manifest": 5,
  "prefix": "wallet",
  "name": "Wallet",
  "description": "The private things you carry, readable only by you: cards with scannable codes, encrypted in your browser, working offline",
  "icon": "/icons/icon.svg",
  "port": 3006,
  "health": "/api/health",
  "launch": "/",
  "signIn": {
    "redirect": ["/api/auth/callback/sovereign"],
    "backChannel": "/api/sovereign/backchannel-logout",
    "accountDeleted": "/api/sovereign/account-deleted",
    "export": "/api/sovereign/export",
    "scopes": ["openid", "profile", "email"]
  },
  "database": true,
  "generate": [
    "WALLET_AUTH_SECRET",
    {
      "name": "WALLET_ENCRYPTION_KEY",
      "bytes": 32
    }
  ],
  "core": ">=0.126.0 <1.0.0"
}
