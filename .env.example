# Every setting Wallet reads, in one place. Copy to `.env` and edit; keep it out of version control, since it holds secrets. `deploy/` has the
# same for each way of running it. A secret may be given as NAME_FILE=/path instead of NAME=value, so that it is never in the process list.
# An instance that hosts Wallet gives it what it needs itself (contracts/app-manifest.md §3), and the rest comes from the operator.

# --- The address people use ----------------------------------------------------------------------------------------------------------
# https, except on localhost, with no path. Passkeys, emailed links and the Sovereign redirect address are made from it.
WALLET_URL=http://localhost:3006

# --- Background jobs -------------------------------------------------------------------------------------------------------------------
# Clean-up runs inside the web process. When several processes share one database, set `off` on all but one.
# WALLET_WORKER=on

# --- Signing in: at least one way must be on -------------------------------------------------------------------------------------------
# Email and password, passkeys and two-factor.
WALLET_AUTH_LOCAL=1
# 32 characters or more:  openssl rand -base64 48
WALLET_AUTH_SECRET=
# `closed`: the first account only. `open`: anyone who can reach the page. Unset, it is `closed`, or `open` when a Sovereign core is the only way in.
WALLET_AUTH_SIGNUP=closed
# The shortest password, 8 to 128. Default 10.
# WALLET_AUTH_PASSWORD_MIN_LENGTH=10

# Sovereign sign-in (optional; all three together, and either way of signing in, or both, can be on). WALLET_CORE_URL is the instance's core, its OIDC
# issuer: its address with no path and no trailing slash, https (http for localhost). Register the client at core with the redirect address
# <WALLET_URL>/api/auth/callback/sovereign. Needs WALLET_URL and WALLET_AUTH_SECRET as local sign-in does; WALLET_AUTH_LOCAL may then be 0.
# WALLET_CORE_URL=https://sovereign.example.com
# WALLET_CORE_CLIENT_ID=
# WALLET_CORE_CLIENT_SECRET=

# --- Database: one of three forms --------------------------------------------------------------------------------------------------------
# `sqld` (the default), `sqlite` or `postgres`. Nothing guesses it from an address.
# WALLET_DB_DIALECT=sqld
# sqld: the service, and the address that makes its namespaces.
# WALLET_SQLD_URL=http://sqld:8080
# WALLET_SQLD_ADMIN_URL=http://sqld:8081
# sqlite: a file, for one container. Never on a network filesystem.
# WALLET_SQLITE_URL=file:/data/wallet.db
# postgres: the address, a root certificate for TLS, and the most connections the app may hold (2 or more).
# WALLET_POSTGRES_URL=postgres://user:password@localhost:5432/wallet
# PGSSLROOTCERT=
# WALLET_POSTGRES_POOL_MAX=10
# How long to wait for a database that is still starting, in milliseconds. Default 30000.
# WALLET_DB_CONNECT_TIMEOUT_MS=30000
# Where the migrations are, if not beside the server.
# WALLET_MIGRATIONS_DIR=

# --- The server's own key ------------------------------------------------------------------------------------------------------------------
# Seals the server's own secrets at rest (a git repository's token, after 0.1.0). **It never touches what you keep in your wallet:** that is sealed
# in your browser under your own key, and the server cannot read it. Make it once and keep it with your secrets, apart from the database backups:
# a lost key means connecting a repository again.   openssl rand -base64 32
WALLET_ENCRYPTION_KEY=
# When changing the key, put the old one here until the server has started once with both.
# WALLET_ENCRYPTION_KEY_PREVIOUS=

# --- Mail (optional) --------------------------------------------------------------------------------------------------------------------
# With a host, a new account's address is verified and a password is reset by mail. Without one neither is offered.
# WALLET_SMTP_HOST=smtp.example.com
# WALLET_SMTP_PORT=587
# WALLET_SMTP_FROM=Wallet <wallet@example.com>
# WALLET_SMTP_USER=
# WALLET_SMTP_PASSWORD=

# --- Limits (optional) --------------------------------------------------------------------------------------------------------------------
# What an account may hold. Going over is refused with a sentence.
# Everything an account keeps, padded, in megabytes. Default 500.
# WALLET_STORAGE_MAX_ACCOUNT_MB=500
# The largest sealed body of one entry, in kilobytes. Default 256.
# WALLET_ENTRY_MAX_KB=256
# Entries per account. Default 50000.
# WALLET_LIMIT_ENTRIES=50000
