{
  "name": "@sovereignfs/wallet",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignfs/wallet.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "description": "Wallet: the private things you carry, encrypted so that only you can read them, offline first, on its own or on a Sovereign instance.",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "next dev --port 3006",
    "build": "next build",
    "start": "PORT=${PORT:-3006} node .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "manifest:check": "sovereign-manifest check",
    "db:generate": "node scripts/db-generate.mjs",
    "db:dev": "node scripts/dev-db.mjs",
    "boot-check": "node scripts/boot-check.mjs",
    "seed": "node scripts/seed-run.mjs",
    "e2e": "playwright test",
    "predev": "node scripts/copy-wasm.mjs",
    "prebuild": "node scripts/copy-wasm.mjs",
    "pretest": "node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "~1.7.16",
    "@better-auth/passkey": "1.7.16",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@libsql/client": "^0.18.0",
    "@sovereignfs/config": "0.1.0",
    "@sovereignfs/sdk": "2.1.0",
    "@sovereignfs/ui": "0.92.0",
    "age-encryption": "0.3.1",
    "better-auth": "~1.7.16",
    "bwip-js": "4.9.1",
    "drizzle-orm": "^0.45.4",
    "hash-wasm": "4.12.0",
    "idb": "^8.0.4",
    "next": "^16.4.3",
    "nodemailer": "10.3.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zxing-wasm": "3.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@sovereignfs/manifest": "^0.1.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "jose": "6.2.13",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
